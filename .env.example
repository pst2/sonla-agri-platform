# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG - HỆ THỐNG TRUYỀN THÔNG & PHÂN TÍCH NÔNG SẢN SƠN LA
# Sao chép file này thành `.env` tại thư mục gốc trước khi chạy ứng dụng.
# ==============================================================================

# 1. Thông tin Dự án & Backend FastAPI
PROJECT_NAME="Agri Communication Platform - Sơn La"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# 2. Cấu hình Cơ sở dữ liệu (PostgreSQL khuyến nghị cho Production / Docker, SQLite cho Local Dev)
# Tùy chọn A: SQLite Local (Mặc định tự động khởi tạo tại database/agri_platform.db)
DATABASE_URL="sqlite:///./database/agri_platform.db"

# Tùy chọn B: PostgreSQL 15 (Bỏ comment dòng dưới khi chạy cùng Docker hoặc PostgreSQL Server)
# DATABASE_URL="postgresql://agri_admin:agri_secret_2026@localhost:5432/sonla_agri_db"

POSTGRES_USER="agri_admin"
POSTGRES_PASSWORD="agri_secret_2026"
POSTGRES_DB="sonla_agri_db"

# 3. Bảo mật & Xác thực JWT (Admin RBAC)
SECRET_KEY="sonla-agri-heritage-secret-key-2026-uet-thesis"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 4. Đường dẫn Lưu trữ Mô hình Học máy & Dữ liệu
ML_ARTIFACTS_DIR="./ml/artifacts"
ML_DATA_DIR="./ml/data"

# 5. Cấu hình Frontend Next.js
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
